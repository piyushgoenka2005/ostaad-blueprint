# Ostaad Blueprint-to-BOQ Engine Configuration
# Copy this file to `.env` and configure your settings.

# Optional: Google Gemini API Key for multi-modal VLM semantic reasoning
# If not provided, the engine runs locally in 100% deterministic offline mode
GEMINI_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000

# Cloudflare Tunnel Configuration (Optional)
# Obtain this token from Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
