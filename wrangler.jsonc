{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ostaad-blueprint-boq",
  "main": "worker.js",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "blueprint.ostaad.shop", "custom_domain": true }
  ],
  "vars": {
    "BACKEND_ORIGIN": "http://127.0.0.1:8000"
  }
}
